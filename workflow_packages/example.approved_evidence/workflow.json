{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "example.approved_evidence",
    "title": "Inspect an approved post batch",
    "description": "A qualification example that copies one selected approved post batch with its immutable source reference. No model or external delivery.",
    "version": "1.0.0",
    "executor": "workflow.code",
    "schedule_modes": ["on_demand"],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {"type": "string", "format": "uuid"},
        "posts_run_id": {"type": "string", "format": "uuid", "title": "Approved post batch"}
      },
      "required": ["project_id", "posts_run_id"]
    },
    "code": {
      "runtime": "python3.12.8-stdlib-v1",
      "entrypoint": "main.py",
      "files": ["main.py"],
      "timeout_seconds": 10,
      "evidence": {
        "posts": {
          "kind": "approved_output",
          "input": "posts_run_id",
          "workflow_key": "social.post_batch",
          "max_bytes": 32000
        }
      },
      "output": {
        "kind": "project.artifact",
        "path": "reports/SELECTED_POST_BATCH.md",
        "media_type": "text/markdown",
        "max_bytes": 40000
      }
    }
  }
}
