{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "growth.community_signal",
    "title": "Find conversations worth joining",
    "description": "Find recent public conversations where the business's target customers are actively describing a problem, rank the best opportunities, and prepare genuinely useful responses for human review.",
    "version": "1.0.0",
    "executor": "codex.procedure",
    "schedule_modes": [
      "on_demand",
      "weekly"
    ],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "product_url": {
          "type": "string",
          "format": "uri",
          "minLength": 8,
          "maxLength": 2000,
          "title": "Product URL"
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Target audience"
        },
        "pain_points": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000,
          "title": "Problems to listen for"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "string",
            "enum": [
              "reddit",
              "hacker_news",
              "product_hunt",
              "other_public_web"
            ]
          },
          "title": "Sources to scan"
        }
      },
      "required": [
        "project_id",
        "product_url",
        "audience",
        "pain_points",
        "sources"
      ]
    },
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": [
        "skills/community-signal/SKILL.md"
      ],
      "entry_skill": "community-signal",
      "workspace": {
        "kind": "github.repository",
        "provider_key": "infra.github",
        "capabilities": [
          "contents.read",
          "pull_requests.read"
        ]
      },
      "sandbox": {
        "profile": "browser",
        "egress": "open",
        "timeout_seconds": 900
      },
      "output": {
        "kind": "github.pull_request",
        "provider_key": "infra.github",
        "max_files": 1,
        "max_bytes": 50000,
        "receipt_path_template": "reports/community-signal/{run_id}.md",
        "allow_no_change": true
      },
      "verification": {
        "commands": [
          "git diff --check"
        ]
      }
    }
  }
}

