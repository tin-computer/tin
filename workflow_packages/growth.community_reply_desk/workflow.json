{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "growth.community_reply_desk",
    "title": "Find community reply opportunities",
    "description": "Find fresh public discussions where a founder can help, then draft useful non-spam replies and follow-up notes.",
    "version": "1.0.0",
    "executor": "codex.procedure",
    "schedule_modes": [
      "on_demand",
      "daily",
      "weekly"
    ],
    "human_review": {
      "eligible": true,
      "reason": "Produces draft public replies for communities.",
      "summary": "Review every suggested reply before posting it yourself."
    },
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "product_url": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "maxLength": 2048,
          "title": "Product URL",
          "description": "The public page that explains the product."
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Audience",
          "description": "Who the product helps and what job they are trying to do.",
          "x-tin-ui": {
            "control": "textarea",
            "order": 10
          }
        },
        "problem_terms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "title": "Problem phrases",
          "description": "Search phrases prospects might use while asking for help."
        },
        "communities": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "default": [],
          "title": "Communities to check",
          "description": "Optional public communities, forums or domains such as r/SaaS, Hacker News or discourse.example.com."
        },
        "lookback_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "default": 7,
          "title": "Freshness window in days"
        },
        "offer_boundary": {
          "type": "string",
          "maxLength": 1000,
          "default": "",
          "title": "Offer boundary",
          "description": "What the reply may and may not mention about the product.",
          "x-tin-ui": {
            "control": "textarea",
            "order": 20
          }
        },
        "notes": {
          "type": "string",
          "maxLength": 2000,
          "default": "",
          "title": "Notes",
          "description": "Extra filters, competitor names, excluded topics or tone preferences.",
          "x-tin-ui": {
            "control": "textarea",
            "order": 30
          }
        }
      },
      "required": [
        "project_id",
        "product_url",
        "audience",
        "problem_terms"
      ]
    },
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": [
        "skills/community-reply-desk/SKILL.md"
      ],
      "entry_skill": "community-reply-desk",
      "workspace": {
        "kind": "project.state"
      },
      "sandbox": {
        "profile": "browser",
        "egress": "open",
        "timeout_seconds": 1800
      },
      "output": {
        "kind": "project.artifact",
        "path_template": "reports/community-reply-desk/{run_id}.md",
        "media_type": "text/markdown",
        "max_bytes": 64000
      }
    }
  }
}
