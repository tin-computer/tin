{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "growth.acquisition_analytics",
    "title": "Weekly growth analytics",
    "description": "Each week: where visitors and signups came from, by channel and by named AI assistant, Search Console clicks with a brand split, content reading, landing pages and first-touch activation. A change is called only when an exact test with Holm's correction says it is real, and each decision names the workflow that acts on it. Read-only; no model calls.",
    "version": "1.0.0",
    "executor": "workflow.code",
    "system": "organic-traffic",
    "schedule_modes": [
      "on_demand",
      "weekly"
    ],
    "prerequisites": [
      {
        "kind": "artifact",
        "level": "recommended",
        "path": "analytics/traffic-snapshot.json",
        "producer": "organic.traffic_snapshot",
        "reason": "The snapshot supplies the site's hosts, brand terms, events and team exclusions, and first-touch signups per content page."
      }
    ],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "signup_event": {
          "type": "string",
          "maxLength": 128,
          "title": "Signup event",
          "description": "Leave empty to use the traffic snapshot's."
        },
        "activation_event": {
          "type": "string",
          "maxLength": 128,
          "title": "Activation event",
          "description": "Channels are ranked by activated signups when this is set. Leave empty to use the traffic snapshot's."
        },
        "activation_window_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "title": "Days after signup that count as activation"
        },
        "paid_event": {
          "type": "string",
          "maxLength": 128,
          "title": "Paid event",
          "description": "The PostHog event for a first payment, counted within 28 days of signup."
        },
        "website_hosts": {
          "type": "array",
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 253
          },
          "title": "Website hosts",
          "description": "Leave empty to use the traffic snapshot's."
        },
        "brand_terms": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": "Brand terms (regular expressions)",
          "description": "Leave empty to use the traffic snapshot's."
        },
        "exclude_email_domains": {
          "type": "array",
          "maxItems": 10,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 63
          },
          "title": "Team email domains to exclude",
          "description": "Leave empty to use the traffic snapshot's."
        },
        "internal_flag_property": {
          "type": "string",
          "maxLength": 71,
          "title": "Internal-user flag property"
        },
        "content_paths": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "title": "Content path prefixes",
          "description": "Defaults to /blog/, /docs/, /guides/ and /changelog/."
        },
        "min_count": {
          "type": "integer",
          "minimum": 5,
          "maximum": 100,
          "default": 20,
          "title": "Smallest count a change is tested on"
        },
        "optional_rules": {
          "type": "array",
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "plateau",
              "platform_dependence"
            ]
          },
          "title": "Extra decision rules"
        },
        "launch_dates": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 10,
            "maxLength": 10
          },
          "title": "Launch or announcement dates (YYYY-MM-DD)",
          "description": "Weeks holding one are marked, so a spike is not read as a trend."
        },
        "impressions_reliable_from": {
          "type": "string",
          "maxLength": 10,
          "title": "Impressions reliable from (YYYY-MM-DD)"
        }
      },
      "required": [
        "project_id"
      ]
    },
    "integration_requirements": [
      {
        "provider_key": "analytics.posthog",
        "capabilities": [
          "query.read"
        ],
        "required": true
      },
      {
        "provider_key": "analytics.gsc",
        "capabilities": [
          "search_analytics.read"
        ],
        "required": true
      }
    ],
    "code": {
      "runtime": "python3.12.8-stdlib-v1",
      "entrypoint": "main.py",
      "files": [
        "main.py",
        "channels.py"
      ],
      "timeout_seconds": 60,
      "services": {
        "posthog": {
          "provider_key": "analytics.posthog",
          "max_calls": 4,
          "max_response_bytes": 64000
        },
        "gsc": {
          "provider_key": "analytics.gsc",
          "max_calls": 3,
          "max_response_bytes": 64000
        }
      },
      "output": {
        "kind": "project.artifact",
        "path": "analytics/GROWTH_ANALYTICS.md",
        "media_type": "text/markdown",
        "max_bytes": 64000
      }
    }
  }
}
