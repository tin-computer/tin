{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "outreach.awesome_lists",
    "title": "Get your product into the awesome lists that will actually accept it",
    "description": "A founder with a public product or repository gets the curated GitHub lists whose own rules it meets, ranked, with the exact entry and pull request text for each, and the one fix that would unlock the most others. Submit to awesome lists sends the entries you approve from your GitHub account.",
    "executor": "codex.procedure",
    "system": "cold-outreach",
    "version": "1.2.1",
    "schedule_modes": [
      "on_demand"
    ],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id"
      ],
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "product_url": {
          "type": "string",
          "title": "Product URL (optional). Leave empty to use the one in the growth plan.",
          "maxLength": 2000,
          "x-tin-ui": {
            "control": "text",
            "order": 10
          },
          "default": ""
        },
        "repository_url": {
          "type": "string",
          "title": "Public repository URL (optional). Leave empty to use the connected repository or the one linked from the site.",
          "maxLength": 500,
          "default": "",
          "x-tin-ui": {
            "control": "text",
            "order": 20
          }
        },
        "category": {
          "type": "string",
          "title": "What the product is, in the words a list would use (optional)",
          "maxLength": 600,
          "default": "",
          "x-tin-ui": {
            "control": "textarea",
            "order": 30
          }
        },
        "avoid": {
          "type": "string",
          "title": "Lists or topics to avoid (optional)",
          "maxLength": 1000,
          "default": "",
          "x-tin-ui": {
            "control": "textarea",
            "order": 40
          }
        }
      }
    },
    "prerequisites": [
      {
        "kind": "artifact",
        "level": "recommended",
        "path": "reports/GROWTH_ONBOARDING_PLAN.md",
        "producer": "growth.onboarding_plan",
        "reason": "The growth plan names the product URL, what the product is and the hard no's, so the founder does not type them again."
      },
      {
        "kind": "artifact",
        "level": "recommended",
        "path": "wiki/INDEX.md",
        "section": "### Code map",
        "producer": "product.code_map",
        "reason": "The Code map names the connected repository, its license and stack, which most lists test before accepting an entry."
      }
    ],
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": [
        "skills/awesome-lists/SKILL.md",
        "skills/awesome-lists/REPORT_TEMPLATE.md"
      ],
      "entry_skill": "awesome-lists",
      "workspace": {
        "kind": "project.state"
      },
      "sandbox": {
        "profile": "isolated",
        "egress": "fenced",
        "timeout_seconds": 1800
      },
      "output": {
        "kind": "project.artifact",
        "path_template": "reports/awesome-lists/{run_id}.md",
        "media_type": "text/markdown",
        "max_bytes": 250000
      }
    },
    "presentation": {
      "flow": {
        "direction": "TD",
        "nodes": [
          {"id": "context", "kind": "store", "label": "Growth plan and Code map", "fact": "product URL, repo, license, hard no's"},
          {"id": "lists", "kind": "surface", "label": "GitHub awesome lists", "fact": "about 30, README and contributing guide"},
          {"id": "rules", "kind": "step", "label": "Test each list's own rules", "fact": "alive in 12 months, each rule tested"},
          {"id": "score", "kind": "step", "label": "Score the lists that pass", "fact": "out of 7, top 5 get exact entries"},
          {"id": "report", "kind": "store", "label": "Report in project Files", "fact": "reports/awesome-lists, submissions block"},
          {"id": "receipt", "kind": "receipt", "label": "Entries ready to review", "fact": "sent from your GitHub only once approved"}
        ],
        "edges": [
          {"from": "context", "to": "lists", "kind": "call"},
          {"from": "lists", "to": "rules", "kind": "call"},
          {"from": "rules", "to": "score", "kind": "call"},
          {"from": "rules", "to": "report", "kind": "call", "label": "no list passes"},
          {"from": "score", "to": "report", "kind": "call"},
          {"from": "report", "to": "receipt", "kind": "call"},
          {"from": "report", "to": "score", "kind": "signal", "label": "next run skips these"}
        ]
      }
    }
  }
}
