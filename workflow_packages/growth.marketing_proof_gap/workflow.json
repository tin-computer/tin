{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "growth.marketing_proof_gap",
    "title": "Marketing Proof Gap",
    "description": "Match marketing claims to supplied evidence and recommend one grounded proof action for each claim.",
    "version": "1.0.0",
    "executor": "workflow.code",
    "schedule_modes": ["on_demand"],
    "human_review": {
      "eligible": true,
      "summary": "Review marketing proof-gap recommendations"
    },
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid",
          "maxLength": 100
        },
        "claim_ids": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "claim_texts": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "claim_surfaces": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "maxLength": 40
          }
        },
        "source_ids": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        },
        "source_texts": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "maxLength": 1400
          }
        },
        "source_types": {
          "type": "array",
          "maxItems": 12,
          "items": {
            "type": "string",
            "maxLength": 80
          }
        }
      },
      "required": [
        "project_id",
        "claim_ids",
        "claim_texts",
        "claim_surfaces",
        "source_ids",
        "source_texts",
        "source_types"
      ]
    },
    "code": {
      "runtime": "python3.12.8-stdlib-v1",
      "entrypoint": "main.py",
      "files": ["main.py"],
      "timeout_seconds": 60,
      "model_routes": {
        "match": {
          "provider": "openai",
          "model": "gpt-5.6-luna",
          "max_calls": 1,
          "max_input_bytes": 24000,
          "max_output_tokens": 4096
        },
        "recommend": {
          "provider": "openai",
          "model": "gpt-5.6-luna",
          "max_calls": 1,
          "max_input_bytes": 24000,
          "max_output_tokens": 4096
        }
      },
      "output": {
        "kind": "project.artifact",
        "path": "reports/MARKETING_PROOF_GAPS.json",
        "media_type": "application/json",
        "max_bytes": 45000
      }
    }
  }
}
