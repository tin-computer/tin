{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "growth.landing_page_cro",
    "title": "Audit a landing page for conversion opportunities",
    "description": "Inspect one landing page for a founder-defined conversion goal and produce an evidence-backed, prioritized experiment backlog.",
    "executor": "codex.procedure",
    "version": "1.0.0",
    "schedule_modes": ["on_demand"],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "site_url": {
          "type": "string",
          "format": "uri",
          "minLength": 8,
          "maxLength": 2000,
          "title": "Landing page URL"
        },
        "conversion_goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "title": "Primary conversion goal",
          "description": "The action the landing page should persuade the visitor to take."
        },
        "audience": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "title": "Target audience",
          "description": "The audience the landing page is intended to convert."
        },
        "focus": {
          "type": "string",
          "maxLength": 1000,
          "default": "",
          "title": "Optional focus",
          "description": "A conversion-path area to inspect first, without excluding other material evidence."
        },
        "analytics_context": {
          "type": "string",
          "maxLength": 4000,
          "default": "",
          "title": "Optional analytics context",
          "description": "Founder-supplied analytics observations or bounded report excerpts."
        }
      },
      "required": [
        "project_id",
        "site_url",
        "conversion_goal",
        "audience"
      ]
    },
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": [
        "skills/landing-page-cro/SKILL.md"
      ],
      "entry_skill": "landing-page-cro",
      "workspace": {
        "kind": "project.state"
      },
      "sandbox": {
        "profile": "isolated",
        "egress": "fenced",
        "timeout_seconds": 900
      },
      "output": {
        "kind": "project.artifact",
        "path": "reports/cro/LANDING_PAGE_CRO_AUDIT.md",
        "media_type": "text/markdown",
        "max_bytes": 120000
      }
    }
  }
}
