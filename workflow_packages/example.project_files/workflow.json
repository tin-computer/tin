{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "example.project_files",
    "title": "Read project brand notes",
    "description": "An example of reading BRAND.md, with caller-supplied notes only when that file is missing. No model or external delivery.",
    "version": "1.0.0",
    "executor": "workflow.code",
    "schedule_modes": ["on_demand", "daily", "weekly"],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {"type": "string", "format": "uuid"},
        "brand_notes": {
          "type": "string",
          "maxLength": 10000,
          "title": "Brand notes",
          "description": "Used only when the project has no BRAND.md.",
          "x-tin-ui": {"control": "textarea"}
        }
      },
      "required": ["project_id"]
    },
    "code": {
      "runtime": "python3.12.8-stdlib-v1",
      "entrypoint": "main.py",
      "files": ["main.py"],
      "timeout_seconds": 15,
      "output": {
        "kind": "project.artifact",
        "path": "reports/BRAND_REFERENCE.md",
        "media_type": "text/markdown",
        "max_bytes": 32000
      }
    },
    "presentation": {
      "flow": {
        "direction": "TD",
        "nodes": [
          {"id": "brand", "kind": "store", "label": "BRAND.md in project Files", "fact": "project root, at most 30,000 bytes"},
          {"id": "notes", "kind": "step", "label": "Use your brand notes instead", "fact": "only when BRAND.md is missing"},
          {"id": "none", "kind": "ghost", "label": "Nothing to read", "fact": "no file and no notes, the run fails"},
          {"id": "receipt", "kind": "receipt", "label": "Brand reference", "fact": "BRAND_REFERENCE.md in reports, no model"}
        ],
        "edges": [
          {"from": "brand", "to": "receipt", "kind": "call", "label": "file found"},
          {"from": "brand", "to": "notes", "kind": "call", "label": "file missing"},
          {"from": "notes", "to": "receipt", "kind": "call"},
          {"from": "notes", "to": "none", "kind": "call", "label": "notes empty"}
        ]
      }
    }
  }
}
