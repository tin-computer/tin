{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "social.post_batch",
    "title": "Draft social posts from a weekly plan or article",
    "description": "Draft reviewable X and LinkedIn posts from an editable weekly plan and current source notes, or repurpose an article. Nothing is posted or scheduled.",
    "version": "3.1.0",
    "executor": "workflow.code",
    "system": "x",
    "schedule_modes": ["on_demand"],
    "human_review": {
      "eligible": true,
      "summary": "Check each social draft against its source material before posting it yourself."
    },
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {"type": "string", "format": "uuid"},
        "mode": {"type": "string", "enum": ["weekly", "repurpose"], "default": "repurpose", "title": "Drafting mode"},
        "plan_path": {"type": "string", "maxLength": 512, "default": "social/PLAN.md", "title": "Weekly plan file", "x-tin-ui": {"control": "project_file"}},
        "sources_path": {"type": "string", "maxLength": 512, "default": "context/social-updates.md", "title": "Current source notes file", "x-tin-ui": {"control": "project_file"}},
        "raw_material": {"type": "string", "maxLength": 12000, "title": "Optional current source notes", "x-tin-ui": {"control": "textarea"}},
        "article_path": {
          "type": "string",
          "maxLength": 512,
          "title": "Article file",
          "x-tin-ui": {"control": "project_file"},
          "description": "A relative project-file path. If omitted, a single matching article is used automatically."
        },
        "article_text": {
          "type": "string",
          "maxLength": 20000,
          "title": "Article text",
          "description": "Optional text to use when no article file is available or several files match.",
          "x-tin-ui": {"control": "textarea"}
        }
      },
      "required": ["project_id"]
    },
    "code": {
      "runtime": "python3.12.8-stdlib-v1",
      "entrypoint": "main.py",
      "files": ["main.py"],
      "timeout_seconds": 60,
      "model_routes": {
        "draft": {
          "provider": "openai",
          "model": "gpt-6-sol",
          "max_calls": 1,
          "max_input_bytes": 32000,
          "max_output_tokens": 4096
        }
      },
      "output": {
        "kind": "project.artifact",
        "path": "social/posts/{date}-{slug}.md",
        "media_type": "text/markdown",
        "max_bytes": 24000
      }
    },
    "presentation": {
      "flow": {
        "direction": "TD",
        "nodes": [
          {"id": "weekly", "kind": "store", "label": "Weekly plan and new notes", "fact": "1 to 6 slots, notes unused in 12 batches"},
          {"id": "article", "kind": "store", "label": "Article to repurpose", "fact": "the one article found, or text you paste"},
          {"id": "draft", "kind": "step", "label": "Draft the posts", "fact": "one model call, 4 posts or one per slot"},
          {"id": "check", "kind": "step", "label": "Check each draft", "fact": "cited excerpt, no links, no new numbers"},
          {"id": "batch", "kind": "store", "label": "Batch in project Files", "fact": "social/posts, dated, one file per run"},
          {"id": "review", "kind": "gate", "label": "Review the drafts", "fact": "the run waits for you, no timer"},
          {"id": "receipt", "kind": "receipt", "label": "Drafts to post yourself", "fact": "Tin posts and schedules nothing"}
        ],
        "edges": [
          {"from": "weekly", "to": "draft", "kind": "call", "label": "weekly mode"},
          {"from": "article", "to": "draft", "kind": "call", "label": "repurpose mode"},
          {"from": "weekly", "to": "batch", "kind": "call", "label": "no new notes"},
          {"from": "draft", "to": "check", "kind": "call"},
          {"from": "check", "to": "batch", "kind": "call"},
          {"from": "batch", "to": "review", "kind": "call"},
          {"from": "review", "to": "receipt", "kind": "signal", "label": "approved"}
        ]
      }
    }
  }
}
