{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "custom.workflow_create",
    "title": "Create a workflow",
    "description": "Turn a brief into a candidate Tin package and versioned qualification cases. Review and qualify the candidate before activation or public contribution.",
    "version": "1.1.0",
    "executor": "codex.procedure",
    "schedule_modes": [
      "on_demand"
    ],
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "format": "uuid"
        },
        "brief": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32000,
          "title": "What should the workflow do?"
        },
        "workflow_key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "title": "Candidate workflow key"
        },
        "scope": {
          "type": "string",
          "enum": [
            "private",
            "public"
          ],
          "default": "private",
          "title": "Intended scope"
        },
        "constraints": {
          "type": "string",
          "maxLength": 4000,
          "default": "",
          "title": "Constraints and acceptance criteria"
        }
      },
      "required": [
        "project_id",
        "brief",
        "workflow_key"
      ]
    },
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": [
        "skills/create-workflow/SKILL.md",
        "skills/create-workflow/CONTRACT.md",
        "skills/create-workflow/code-example.json",
        "skills/create-workflow/procedure-example.json"
      ],
      "entry_skill": "create-workflow",
      "workspace": {
        "kind": "project.state"
      },
      "sandbox": {
        "profile": "isolated",
        "egress": "fenced",
        "timeout_seconds": 900
      },
      "output": {
        "kind": "project.artifact",
        "path": "reports/WORKFLOW_CANDIDATE.json",
        "media_type": "application/json",
        "max_bytes": 512000
      }
    },
    "presentation": {
      "flow": {
        "direction": "TD",
        "nodes": [
          {
            "id": "brief",
            "kind": "step",
            "label": "Read the brief",
            "fact": "the job, its inputs, output and effects"
          },
          {
            "id": "choose",
            "kind": "step",
            "label": "Choose the executor",
            "fact": "code first, a model or agent only if needed"
          },
          {
            "id": "write",
            "kind": "step",
            "label": "Write the package",
            "fact": "manifest, code or prompt, and its diagram"
          },
          {
            "id": "check",
            "kind": "step",
            "label": "Check it locally",
            "fact": "synthetic data only, no provider access"
          },
          {
            "id": "candidate",
            "kind": "receipt",
            "label": "Candidate in project Files",
            "fact": "reports/WORKFLOW_CANDIDATE.json, not active"
          }
        ],
        "edges": [
          {
            "from": "brief",
            "to": "choose",
            "kind": "call"
          },
          {
            "from": "choose",
            "to": "write",
            "kind": "call"
          },
          {
            "from": "write",
            "to": "check",
            "kind": "call"
          },
          {
            "from": "check",
            "to": "candidate",
            "kind": "call"
          }
        ]
      }
    }
  }
}
