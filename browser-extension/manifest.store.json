{
  "manifest_version": 3,
  "name": "Tin Computer for LinkedIn BETA",
  "description": "THIS EXTENSION IS FOR BETA TESTING. Connect LinkedIn to Tin and collect visible connections.",
  "version": "0.4.2",
  "minimum_chrome_version": "120",
  "permissions": [
    "alarms",
    "cookies",
    "storage",
    "webRequest",
    "scripting"
  ],
  "host_permissions": [
    "https://api.tin.computer/*",
    "https://tin.computer/*",
    "https://www.tin.computer/*",
    "https://*.linkedin.com/*",
    "https://app.tin.computer/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Tin Computer for LinkedIn BETA",
    "default_popup": "popup/collection.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://tin.computer/*",
        "https://www.tin.computer/*"
      ],
      "js": [
        "src/protocol.js",
        "src/tin-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://tin.computer/*",
        "https://www.tin.computer/*",
        "https://app.tin.computer/*"
      ],
      "js": [
        "src/collection/bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
